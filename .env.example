# Copiá este archivo a .env.local y completá los valores.
# Todas las vars NEXT_PUBLIC_* se exponen al browser — NUNCA pongas acá la
# service_role key de Supabase ni ningún secreto de servidor.

# Servidor de autenticación. El prototipo usa GoTrue autoalojado, que el Caddy
# del host expone bajo api.insyta.space/auth/v1/*. El cliente es @supabase/ssr,
# que habla el mismo protocolo. La publishable key es browser-safe → NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://api.insyta.space
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<JWT anon firmado con GOTRUE_JWT_SECRET>

# insyta-api base URL (FastAPI). Local: http://localhost:8000 (uvicorn).
# Prod: https://api.insyta.space — contenedores Docker sobre AWS EC2, región sa-east-1.
NEXT_PUBLIC_API_URL=http://localhost:8000
